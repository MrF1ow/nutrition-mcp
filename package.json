{
    "name": "foodable",
    "version": "0.1.0",
    "description": "Self-hosted MCP platform for one household: fridge, groceries, nutrition, recipes, and settings.",
    "author": "Ethan Flow",
    "license": "MIT",
    "homepage": "https://github.com/MrF1ow/nutrition-mcp",
    "repository": {
        "type": "git",
        "url": "https://github.com/MrF1ow/nutrition-mcp.git"
    },
    "keywords": [
        "mcp",
        "nutrition",
        "meal-tracking",
        "claude",
        "model-context-protocol"
    ],
    "module": "index.ts",
    "type": "module",
    "private": true,
    "devDependencies": {
        "@modelcontextprotocol/client": "^2.0.0",
        "@types/bun": "latest"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "scripts": {
        "start": "bun src/index.ts",
        "dev": "bun run gen:all && bun --watch src/index.ts",
        "inspect": "bunx @modelcontextprotocol/inspector",
        "harness": "bun run scripts/widget-harness.ts",
        "test": "bun test",
        "format": "bunx prettier --write .",
        "format:check": "bunx prettier --check .",
        "typecheck": "bun run scripts/typecheck.ts",
        "db:dryrun": "bun run scripts/migration-dryrun.ts",
        "gen:pages": "bun run scripts/gen-login.ts",
        "gen:all": "bun run gen:pages",
        "generate-oauth-creds": "echo \"OAUTH_CLIENT_ID=$(openssl rand -hex 16)\" && echo \"OAUTH_CLIENT_SECRET=$(openssl rand -hex 32)\""
    },
    "dependencies": {
        "@modelcontextprotocol/server": "^2.0.0",
        "@supabase/supabase-js": "^2.116.0",
        "hono": "^4.13.7",
        "prettier": "^3.9.6",
        "zod": "^4.5.4"
    }
}
